{
  "realm": "cityforward",
  "enabled": true,
  "displayName": "CityForward Health",
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "ATTENDING",
        "description": "CityForward Health role ATTENDING"
      },
      {
        "name": "RESIDENT",
        "description": "CityForward Health role RESIDENT"
      },
      {
        "name": "NURSE",
        "description": "CityForward Health role NURSE"
      },
      {
        "name": "PA_COORD",
        "description": "CityForward Health role PA_COORD"
      },
      {
        "name": "HIM_CODER",
        "description": "CityForward Health role HIM_CODER"
      },
      {
        "name": "IT_ADMIN",
        "description": "CityForward Health role IT_ADMIN"
      },
      {
        "name": "COMPLIANCE",
        "description": "CityForward Health role COMPLIANCE"
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"required\": {\"roles\": [\"user\"]}, \"validations\": {\"email\": {}}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"units\", \"displayName\": \"Nursing units / wards\", \"multivalued\": true, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  },
